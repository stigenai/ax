load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "runner",
    srcs = [
        "env.go",
        "launcher.go",
        "runner.go",
        "spec.go",
    ],
    importpath = "github.com/google/ax/runner",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/metadata",
        "//internal/workspace",
        "//pkg/apis/v1alpha1",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "runner_test",
    srcs = [
        "launcher_test.go",
        "runner_test.go",
        "spec_test.go",
    ],
    embed = [":runner"],
    deps = [
        "//internal/workspace",
        "//pkg/apis/v1alpha1",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)
