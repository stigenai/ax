load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "ax_lib",
    srcs = [
        "install_cmd.go",
        "main.go",
        "promote.go",
        "ssh_stale.go",
        "studio_cmd.go",
        "task.go",
        "trace.go",
        "workspace.go",
    ],
    importpath = "github.com/google/ax/cmd/ax",
    visibility = ["//visibility:private"],
    deps = [
        "//client",
        "//internal/guest",
        "//internal/install/axdeploy",
        "//internal/install/cluster",
        "//internal/install/executil",
        "//internal/install/substrate",
        "//internal/telemetry/otelenv",
        "//internal/tunnel",
        "//internal/version",
        "//pkg/apis/v1alpha1",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_opentelemetry_go_contrib_instrumentation_google_golang_org_grpc_otelgrpc//:otelgrpc",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel//propagation",
        "@io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracegrpc//:otlptracegrpc",
        "@io_opentelemetry_go_otel_metric//noop",
        "@io_opentelemetry_go_otel_sdk//resource",
        "@io_opentelemetry_go_otel_sdk//trace",
        "@io_opentelemetry_go_otel_trace//:trace",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)

go_binary(
    name = "ax",
    embed = [":ax_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "ax_test",
    srcs = [
        "apply_test.go",
        "install_cmd_test.go",
        "main_test.go",
        "promote_test.go",
        "ssh_interrupt_test.go",
        "ssh_stale_test.go",
        "studio_cmd_test.go",
        "trace_test.go",
    ],
    embed = [":ax_lib"],
    # ponytail: the test runs `go build .`, and the Bazel sandbox has no go tool. deploy-ci.yml runs it with go test.
    tags = ["manual"],  # keep
    deps = [
        "//internal/controller",
        "//internal/guest",
        "//internal/install/axdeploy",
        "//internal/install/cluster",
        "//internal/install/executil",
        "//internal/server",
        "//internal/store",
        "//internal/store/memory",
        "//internal/substrate/substratetest",
        "//internal/tunnel",
        "//internal/version",
        "//pkg/apis/v1alpha1",
        "@dev_ate_go_substrate//api/ateapi/v1:ateapi",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel_sdk//trace",
        "@io_opentelemetry_go_otel_sdk//trace/tracetest",
        "@io_opentelemetry_go_otel_trace//:trace",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/emptypb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
