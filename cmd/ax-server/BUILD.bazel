load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "ax-server_lib",
    srcs = [
        "main.go",
        "tls.go",
    ],
    importpath = "github.com/google/ax/cmd/ax-server",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/server",
        "//internal/store/redis",
        "@com_github_redis_go_redis_v9//:go-redis",
        "@io_k8s_apimachinery//pkg/api/resource",
    ],
)

go_binary(
    name = "ax-server",
    embed = [":ax-server_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "ax-server_test",
    srcs = [
        "main_test.go",
        "tls_test.go",
    ],
    embed = [":ax-server_lib"],
    deps = ["@io_k8s_apimachinery//pkg/api/resource"],
)
