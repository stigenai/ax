load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "client",
    srcs = ["client.go"],
    importpath = "github.com/google/ax/client",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/tunnel",
        "//pkg/apis/v1alpha1",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_test(
    name = "client_test",
    srcs = ["client_test.go"],
    embed = [":client"],
    deps = [
        "//internal/tunnel",
        "//pkg/apis/v1alpha1",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
