load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "deploy",
    srcs = ["embed.go"],
    embedsrcs = [
        "ax-server.yaml",
        "postgres.yaml",
    ],
    importpath = "github.com/google/ax/deploy",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/apis/v1alpha1",
        "@com_github_google_go_containerregistry//pkg/name",
    ],
)

go_test(
    name = "deploy_test",
    srcs = ["embed_test.go"],
    embed = [":deploy"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)
