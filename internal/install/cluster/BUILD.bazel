load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cluster",
    srcs = [
        "kind.go",
        "provider.go",
        "registry.go",
    ],
    importpath = "github.com/google/ax/internal/install/cluster",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/install/executil",
        "//internal/tunnel",
        "//pkg/apis/v1alpha1",
        "@in_gopkg_yaml_v3//:yaml_v3",
