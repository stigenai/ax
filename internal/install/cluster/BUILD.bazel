)

go_test(
    name = "cluster_test",
    srcs = ["kind_test.go"],
    data = ["//internal/install/substrate:manifests"],  # keep
    embed = [":cluster"],
    deps = [
        "//internal/install/executil",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)
