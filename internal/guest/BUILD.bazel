load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "guest",
    srcs = ["client.go"],
    importpath = "github.com/google/ax/internal/guest",
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_github_agent_substrate_env//proto/ateenv/v1alpha",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
    ],
)

go_test(
    name = "guest_test",
    srcs = ["client_test.go"],
    deps = [
        ":guest",
        "@com_github_agent_substrate_env//guest",
    ],
)
